{
  "name": "ar-carpet-game",
  "version": "v11.3.1",
  "type": "module",
  "private": true,
  "scripts": {
    "test:unit": "jest --config=jest.config.js",
    "test:integration": "jest --config=jest.config.js tests/integration",
    "test:a11y": "jest --config=jest.config.js tests/accessibility",
    "test:smoke": "node scripts/smoke.js || true",
