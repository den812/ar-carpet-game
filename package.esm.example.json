  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@babel/preset-env": "^7.25.0",
    "@playwright/test": "^1.45.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.0.0"
  }
}